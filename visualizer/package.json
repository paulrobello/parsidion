    "docs": "typedoc --out ../docs/api/visualizer --options typedoc.json"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "graphology": "0.26.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "3.0.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@happy-dom/global-registrator": "^20.11.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-types": "^1.4.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "happy-dom": "^20.11.8",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^6"
