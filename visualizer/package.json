    "picomatch": "4.0.4",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
