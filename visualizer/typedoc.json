{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.json",
  "entryPointStrategy": "expand",
  "entryPoints": ["lib"],
  "exclude": ["**/*.test.ts", "**/__fixtures__/**"],
  "readme": "none",
  "githubPages": false,
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/paulrobello/parsidion/blob/main/visualizer/lib/{path}#L{line}",
  "basePath": "lib",
  "excludePrivate": true,
  "logLevel": "Error"
}
