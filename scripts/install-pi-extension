#!/usr/bin/env bash
# Install the parsidion pi extension from this repo into ~/.pi/agent/extensions.
#
#   ./scripts/install-pi-extension [--symlink] [--no-doc] [--extension-dir DIR]
#                                   [--agent-name NAME]
#
# Options:
#   --symlink            Install as symlinks instead of copying files
#   --no-doc             Skip installing parsidion.md
#   --extension-dir DIR  Target extension directory (default: ~/.pi/agent/extensions)
#   --agent-name NAME    Runtime label for the post-install hint (default: pi;
#                        use "omp" when installing into ~/.omp/agent/extensions)
#   --help, -h           Show this help
#
# Examples:
#   ./scripts/install-pi-extension
#   ./scripts/install-pi-extension --symlink
#   ./scripts/install-pi-extension --extension-dir ~/.pi/agent/extensions
#   ./scripts/install-pi-extension --extension-dir ~/.omp/agent/extensions --agent-name omp
#

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    awk '
        NR == 1 { next }
        /^#/ { sub(/^# ?/, ""); print; next }
        { exit }
    ' "$0"
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SRC_DIR="$REPO_ROOT/extensions/pi/parsidion"
SRC_TS="$SRC_DIR/parsidion.ts"
SRC_MD="$SRC_DIR/parsidion.md"
# Every lib/*.ts ships with the extension — enumerated, never hardcoded, so
# adding a lib module cannot be missed by an install (4-of-6 regression).
shopt -s nullglob
LIB_SOURCES=("$SRC_DIR"/lib/*.ts)
shopt -u nullglob

MODE="copy"
INSTALL_DOC="yes"
EXT_DIR="${HOME}/.pi/agent/extensions"
AGENT_NAME="pi"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --symlink)
            MODE="symlink"
            shift
            ;;
        --copy)
            MODE="copy"
            shift
            ;;
        --no-doc)
            INSTALL_DOC="no"
            shift
            ;;
        --extension-dir)
            if [[ $# -lt 2 ]]; then
                echo "error: --extension-dir requires a value" >&2
                exit 1
            fi
            EXT_DIR="$2"
            shift 2
            ;;
        --agent-name)
            if [[ $# -lt 2 ]]; then
                echo "error: --agent-name requires a value" >&2
                exit 1
            fi
            AGENT_NAME="$2"
            shift 2
            ;;
        *)
            echo "error: unknown option: $1" >&2
            exit 1
            ;;
    esac
done

if [[ ! -f "$SRC_TS" ]]; then
    echo "error: missing source file: $SRC_TS" >&2
    exit 1
fi

mkdir -p "$EXT_DIR" "$EXT_DIR/lib"
DST_TS="$EXT_DIR/parsidion.ts"
DST_MD="$EXT_DIR/parsidion.md"

if [[ "$MODE" == "symlink" ]]; then
    ln -sfn "$SRC_TS" "$DST_TS"
    if [[ "$INSTALL_DOC" == "yes" && -f "$SRC_MD" ]]; then
        ln -sfn "$SRC_MD" "$DST_MD"
    fi
    for src in "${LIB_SOURCES[@]}"; do
        ln -sfn "$src" "$EXT_DIR/lib/$(basename "$src")"
    done
else
    cp "$SRC_TS" "$DST_TS"
    if [[ "$INSTALL_DOC" == "yes" && -f "$SRC_MD" ]]; then
        cp "$SRC_MD" "$DST_MD"
    fi
    for src in "${LIB_SOURCES[@]}"; do
        cp "$src" "$EXT_DIR/lib/"
    done
fi

echo "Installed parsidion extension:"
echo "  mode:          $MODE"
echo "  ts:            $DST_TS"
if [[ "$INSTALL_DOC" == "yes" ]]; then
    if [[ -f "$DST_MD" || -L "$DST_MD" ]]; then
        echo "  doc:           $DST_MD"
    fi
fi
if ((${#LIB_SOURCES[@]} > 0)); then
    echo "  lib modules:   ${#LIB_SOURCES[@]} file(s) in lib/"
fi

echo
echo "If script resolution ever fails in /parsidion status, set one of:"
echo "  export PARSIDION_SCRIPTS_DIR=\"$REPO_ROOT/skills/parsidion/scripts\""
echo "  export PARSIDION_DIR=\"$REPO_ROOT\""
echo
echo "Then in ${AGENT_NAME} run:"
echo "  /reload"
echo "  /parsidion"
