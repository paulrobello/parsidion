{
  "$id": "https://parsidion.local/schemas/graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for vault graph.json emitted by build_graph.py and consumed by the TypeScript visualizer (visualizer/lib/graph.ts GraphData).",
  "properties": {
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "semantic",
              "wiki"
            ],
            "type": "string"
          },
          "s": {
            "minLength": 1,
            "type": "string"
          },
          "t": {
            "minLength": 1,
            "type": "string"
          },
          "w": {
            "type": "number"
          }
        },
        "required": [
          "s",
          "t",
          "w",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "edge_count": {
          "minimum": 0,
          "type": "integer"
        },
        "generated": {
          "type": "string"
        },
        "max_neighbors": {
          "description": "Maximum semantic edges kept per note, strongest first (ENH-001). 0 disables the cap and emits every pair above min_semantic_threshold.",
          "minimum": 0,
          "type": "integer"
        },
        "min_semantic_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "note_count": {
          "minimum": 0,
          "type": "integer"
        },
        "parmem_body_links": {
          "description": "Wiki edges contributed by par-mem body-link enrichment. Absent when enrichment was skipped or added nothing.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "generated",
        "note_count",
        "edge_count",
        "min_semantic_threshold"
      ],
      "type": "object"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "folder": {
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "incoming_links": {
            "minimum": 0,
            "type": "integer"
          },
          "mtime": {
            "minimum": 0,
            "type": "number"
          },
          "path": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "folder",
          "path",
          "tags",
          "incoming_links",
          "mtime"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "meta",
    "nodes",
    "edges"
  ],
  "title": "GraphData",
  "type": "object"
}
